# Copy this file to .env and fill it in. Never commit .env.

# Free key from https://the-odds-api.com
ODDS_API_KEY=

# true = use fake odds from sample_data/ (no key needed, no quota used)
USE_SAMPLE_DATA=true

# Postgres (start it with: docker compose up -d)
# Leave blank to use a local SQLite file instead
DATABASE_URL=postgresql+psycopg://utgi:utgi@localhost:5432/utgi

# What to pull. MVP is NFL only.
SPORTS=nfl
MARKETS=h2h,spreads,totals
REGIONS=us
# Optional: limit to specific books, e.g. draftkings,fanduel,betmgm
BOOKMAKERS=

FRONTEND_ORIGIN=http://localhost:3000
